			}):Play()

			task.wait(2)

			ButtonText.Text = "COPY GROUP LINK"
			ButtonSubText.Text = "CLICK TO COPY LINK TO CLIPBOARD"

			ButtonText.TextColor3 = WHITE

			LinkIcon.Text = "↗"
			ButtonArrow.Text = "›"

			StatusDot.BackgroundColor3 = PURPLE_BRIGHT

			SetStatus(
				"Join the group to continue!",
				WHITE
			)

			Tween(CopyStroke, 0.2, {
				Color = PURPLE,
				Thickness = 2
			}):Play()

		else

			StatusDot.BackgroundColor3 = WARNING

